# Resend API key — https://resend.com/api-keys
# Add this to your Vercel project environment variables too.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# --- CRM (admin portal + CLI/agent API) ---

# Postgres connection string. Auto-populated if you add Vercel Postgres (Neon)
# from the Vercel dashboard's Storage tab; copy the same value locally.
DATABASE_URL=postgres://user:password@host/dbname

# Secret used to sign admin session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# bcrypt hash of the admin portal password. Generate with:
#   npm run hash-password -- 'your-password'
ADMIN_PASSWORD_HASH=

# Legacy permanent CLI/agent API key. Existing keys remain supported.
# Generate with: npm run generate-api-key
API_KEY_HASH=

# Optional additional permanent key hashes, separated by commas. Prefer named,
# expiring database keys for new agents: npm run create-agent-api-key -- --name "My agent" --days 365
API_KEY_HASHES=

# Read-only restricted Stripe key for CRM financial reporting. Configure this
# in Vercel and locally; never expose it to browser code.
STRIPE_RESTRICTED_KEY=
